# AniList token is normally filled by the browser/Auth Pin flow.
anilist.accessToken=

# Episode and playback sources are intentionally disabled.

player.watchPercentage=0.85
player.autoPlay=true
player.seekSeconds=10
player.defaultSpeed=1.0
player.subtitleSize=20
player.subtitleDraggable=false
player.subtitleOffsetX=0
player.subtitleOffsetY=0

ui.startTab=HOME
ui.compactCards=false

# Optional Aokvue support checkout links. Each preset can point to its own
# Stripe Payment Link. The custom link should be a customer-chooses-amount link.
support.eur2Url=
support.eur5Url=
support.eur10Url=
support.eur25Url=
support.customUrl=
